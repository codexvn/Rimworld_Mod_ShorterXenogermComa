<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--
    移除异种胚芽植入后的昏迷时间，改为 1 tick。植入后殖民者立即恢复行动。
  -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/HediffDef[defName="XenogerminationComa"]/comps/li[@Class="HediffCompProperties_Disappears"]/disappearsAfterTicks</xpath>
    <value>
      <disappearsAfterTicks>1~1</disappearsAfterTicks>
    </value>
  </Operation>
</Patch>